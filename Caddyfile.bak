oisha.jonbranding.uz {
    @public path /healthz /healthz/ /readyz /readyz/
    handle @public {
        reverse_proxy localhost:8080
    }
    @api path /api/* /webhook/* /docs /openapi.json /static/* /dashboard/* /mcp/*
    @mcp path /telegram-mcp-*
    handle @mcp {
        reverse_proxy localhost:8080
    }

    @oauth path /oauth2/* /telegram-mcp/*
    handle @oauth {
        reverse_proxy localhost:8080
    }
    handle @api {
        basic_auth {
            oisha $2a$14$W9PGL1r/t7uFUPS0ynGGTO8IQ1lXiTmXuyvr/vfiDc4/iYlJDdSai
        }
        reverse_proxy localhost:8080
    }
    # SalesCoach API (NestJS) deploy qilinmagan — ishlaydigan
    # sahifa /admin, root'ni o'sha yerga yo'naltiramiz
    redir / /admin 302
    handle {
        basic_auth {
            oisha $2a$14$W9PGL1r/t7uFUPS0ynGGTO8IQ1lXiTmXuyvr/vfiDc4/iYlJDdSai
        }
        reverse_proxy localhost:3000
    }
}
