[Unit]
Description=Oisha-OS Main Service & AI Autopilot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/oisha-os
Environment=PYTHONPATH=.
Environment=PYTHONIOENCODING=utf-8
ExecStart=/root/oisha-os/.venv/bin/python -u src/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
