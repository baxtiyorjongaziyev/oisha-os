[Unit]
Description=Oisha-OS Self-Healing Watchdog
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/oisha-os
Environment=PYTHONPATH=.
Environment=PYTHONIOENCODING=utf-8
Environment=OISHA_SYSTEMD_SERVICE=oisha-os
Environment=OISHA_HEALTH_URL=http://127.0.0.1:8080/healthz/
ExecStart=/root/oisha-os/venv/bin/python -u src/services/watchdog.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
