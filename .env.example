# Oisha-OS Environment Variables Template
# Copy this file to .env and fill in the values.

# --- TELEGRAM CONFIG ---
# Get API_ID and API_HASH from https://my.telegram.org
API_ID=your_api_id_here
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here
# Session string for the userbot (can be generated via src/get_session.py)
USERBOT_SESSION_STRING=your_session_string_here
# Dedicated MCP session must differ from USERBOT_SESSION_STRING.
TELEGRAM_MCP_SESSION_STRING=your_dedicated_mcp_session_here
TELEGRAM_MCP_UPSTREAM_URL=http://127.0.0.1:8765/mcp
TELEGRAM_MCP_APPROVAL_TTL_SECONDS=900
TELEGRAM_MCP_AGENT_IDS=codex,claude,antigravity
TELEGRAM_PHONE=your_phone_with_country_code
TELEGRAM_PASSWORD=your_2fa_password_if_any

# --- AI CONFIG ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CALL_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
FREE_AI_GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_AI_API_TOKEN=your_cloudflare_ai_api_token_here
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen2.5:3b
FREE_AI_PROVIDER_TIMEOUT_SECONDS=45
# Free / trial LLM fallback providers (github.com/cheahjs/free-llm-api-resources)
# Leave blank to disable a provider; the router skips any without a key.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
TOGETHERAI_API_KEY=
TOGETHERAI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.2-3b-instruct:free
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct
ENABLE_PAID_AI_FALLBACK=0
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-4o-mini
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# --- AMOCRM CONFIG ---
AMOCRM_CLIENT_ID=your_amocrm_client_id_here
AMOCRM_CLIENT_SECRET=your_amocrm_client_secret_here
AMOCRM_REDIRECT_URL=https://your-redirect-url.com
MOIZVONKI_EMAIL=
MOIZVONKI_PASSWORD=
AMOCRM_SUBDOMAIN=your_subdomain
ENABLE_AMOCRM_LEAD_ENRICHMENT=1
AMOCRM_ENRICHMENT_MESSAGE_LIMIT=20
AMOCRM_ENRICHMENT_REFRESH_HOURS=24
ENABLE_AMOCRM_CALL_ANALYSIS=1
AMOCRM_CALL_ANALYSIS_ON_WEBHOOK=1
ENABLE_AMOCRM_CALL_TASKS=1
AMOCRM_CALL_TASK_DUE_HOURS=24
AMOCRM_CALL_ANALYSIS_LIMIT=20
AMOCRM_CALL_BACKFILL_ON_WEBHOOK=1
AMOCRM_CALL_BACKFILL_INTERVAL_MINUTES=60
AMOCRM_CALL_BACKFILL_LIMIT=50
AMOCRM_CALL_MAX_AUDIO_MB=19
AMOCRM_CALL_TRANSCRIPT_NOTE_CHARS=6000

# --- DATABASE CONFIG ---
# For local SQLite, use a local path. For Turso, use the libsql URL.
DATABASE_URL=file:oisha.db
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# --- AIRTABLE CONFIG ---
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_base_id_here

# --- INSTAGRAM / META WEEKLY REPORT ---
# Instagram account Business/Creator bo'lishi va Facebook Pagega ulangan bo'lishi kerak.
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_INSTAGRAM_USER_ID=
# Backward-compatible alias; META_INSTAGRAM_USER_ID bo'lmasa ishlatiladi.
META_INSTAGRAM_ACCOUNT_ID=
# Optional: haftalik post snapshotlarini Airtablega yozish uchun table nomi.
INSTAGRAM_REPORT_AIRTABLE_TABLE=Instagram Weekly Insights
AMOCRM_INTERESTED_STATUS_ID=
AMOCRM_CALLBACK_STATUS_ID=
AMOCRM_REJECTED_STATUS_ID=
AMOCRM_FAILED_STATUS_ID=
OISHA_FEEDBACK_WEBHOOK_URL=

# --- OPERATION MODES ---
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
ENABLE_AI_NEGOTIATION=off
# Auto-reply tiers (auto_reply_gate.py):
#   off      — no replies at all (bot stays silent)
#   shadow   — bot drafts a reply and sends a PREVIEW to the Owner; NEVER auto-sends
#   vip_only — auto-sends only for lead_score >= VIP threshold; rest go to shadow
#   live/auto— auto-sends for matching / all messages
# Default when unset is 'shadow' (fail-safe: draft, never auto-send). Private DMs are
# hard-blocked from auto-reply regardless of mode; only group replies are affected.
AUTO_REPLY_MODE=shadow
ALLOW_LOCAL_RUN=0
ENABLE_CLOUD_USERBOT=1
ENABLE_PERSONAL_FOLDER_EXCLUSION=1
PERSONAL_FOLDER_KEYWORDS=oila,family,shaxsiy,personal,do'st,dost,friends

# --- HISOBCHI (Finance) CONFIG ---
# HISOBCHI_FINANCE_GROUP_ID=-1001234567890
# HISOBCHI_KIRIM_TOPIC_ID=2
# HISOBCHI_CHIQIM_TOPIC_ID=4
# HISOBCHI_PNL_TOPIC_ID=37
# HISOBCHI_CASHFLOW_TOPIC_ID=39
# HISOBCHI_BALANCE_TOPIC_ID=41

# --- HISOBCHI GOOGLE SHEETS BACKEND ---
# HISOBCHI_GSHEET_ID=your_google_sheet_id_here
# HISOBCHI_GSHEET_CREDS_FILE=service_account.json

# Jadvallar (avtomatik yaratiladi):
#   Cashflow     — Biznes karta tranzaksiyalari
#   Shaxsiy      — Shaxsiy karta tranzaksiyalari
#   P&L          — Oylik foyda/zarar yig'indisi
#   Balans       — Karta balanslari
#   MerchantMemory — Merchant->kategoriya xotirasi
#   CategoryRules  — Aniq qoidalar

# --- CLOUD RUN CONFIG (Set automatically in Cloud Run) ---
# K_SERVICE=oisha-master-bot
# RUNNING_IN_CLOUD=1
# RBAC machine identities and trusted loopback proxy mappings.
# Keep empty by default. Values are JSON objects supplied by the secret store.
OISHA_SERVICE_TOKENS_JSON={}
OISHA_PROXY_ROLE_MAP_JSON={}
