# ============================================================
# Oisha-OS - Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Telegram ---
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
BOT_TOKEN=your_bot_token
ADMIN_BOT_TOKEN=your_admin_bot_token  # optional
TELEGRAM_PHONE=+998XXXXXXXXX          # for auth scripts only
TELEGRAM_PASSWORD=                     # for auth scripts only (2FA)
TELEGRAM_CODE=                         # for finish_login.py only
TELEGRAM_HASH=                         # for finish_login.py only

# --- Owner & Access ---
OWNER_ID=your_telegram_user_id
# Comma-separated extra user IDs
WHITELIST_IDS=

# --- Database ---
DATABASE_URL=bot_database.db
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# --- AI ---
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=                      # optional

# --- Autonomous Negotiations Agent ---
SURGICAL_MODE=true
AUTONOMY_THRESHOLD=0.6

# --- AmoCRM ---
AMOCRM_SUBDOMAIN=your_subdomain
AMOCRM_CLIENT_ID=your_client_id
AMOCRM_CLIENT_SECRET=your_client_secret
AMOCRM_REDIRECT_URL=https://localhost

# --- Airtable ---
AIRTABLE_API_KEY=                      # optional
AIRTABLE_BASE_ID=                      # optional

# --- Meta/Facebook ---
META_PAGE_ACCESS_TOKEN=               # for meta integration
META_IG_PAGE_ID=                      # Instagram page ID
META_VERIFY_TOKEN=                    # webhook verify token
META_APP_SECRET=                      # app secret

# --- GitHub ---
GITHUB_TOKEN=your_github_pat

# --- API Security ---
OISHA_API_SECRET=your_random_secret_key

# --- CORS ---
# Comma-separated allowed origins (leave empty for defaults)
ALLOWED_ORIGINS=https://oisha.uz,https://www.oisha.uz

# --- VPS SSH (for debug scripts only) ---
VPS_HOST=104.197.19.4
VPS_USER=baxtiyorjongaziyev
VPS_SSH_PASSWORD=
VPS_HOST_ROOT=109.199.100.137
VPS_USER_ROOT=root
VPS_SSH_PASSWORD_ROOT=

# --- Cloudflare Tunnel ---
CF_TUNNEL_TOKEN=                       # for install_cf_service.py

# --- Telegram Groups ---
CRM_GROUP_ID=
PROJECTS_GROUP_ID=
TEAM_GROUP_ID=
