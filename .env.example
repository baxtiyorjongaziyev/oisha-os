# Oisha-OS Environment Variables Template
# Copy this file to .env and fill in the values.

# --- TELEGRAM CONFIG ---
# Get API_ID and API_HASH from https://my.telegram.org
API_ID=your_api_id_here
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here
# Session string for the userbot (can be generated via src/get_session.py)
USERBOT_SESSION_STRING=your_session_string_here
TELEGRAM_PHONE=your_phone_with_country_code
TELEGRAM_PASSWORD=your_2fa_password_if_any

# --- AI CONFIG ---
GEMINI_API_KEY=your_gemini_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# --- AMOCRM CONFIG ---
AMOCRM_CLIENT_ID=your_amocrm_client_id_here
AMOCRM_CLIENT_SECRET=your_amocrm_client_secret_here
AMOCRM_REDIRECT_URL=https://your-redirect-url.com
AMOCRM_SUBDOMAIN=your_subdomain

# --- DATABASE CONFIG ---
# For local SQLite, use a local path. For Turso, use the libsql URL.
DATABASE_URL=file:oisha.db
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# --- AIRTABLE CONFIG ---
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_base_id_here

# --- OPERATION MODES ---
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
ENABLE_AI_NEGOTIATION=off
AUTO_REPLY_MODE=off
ALLOW_LOCAL_RUN=0
ENABLE_CLOUD_USERBOT=1
ENABLE_PERSONAL_FOLDER_EXCLUSION=1
PERSONAL_FOLDER_KEYWORDS=oila,family,shaxsiy,personal,do'st,dost,friends

# --- CLOUD RUN CONFIG (Set automatically in Cloud Run) ---
# K_SERVICE=oisha-master-bot
# RUNNING_IN_CLOUD=1
