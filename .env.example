# Telegram Bot Configuration
# @BotFather dan oling
BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here
USERBOT_SESSION=your_session_hex_if_needed

# AI API Keys
# Gemini AI API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# DeepSeek API Key (optional, agar Gemini ishlatayotgan bo'lsangiz)
DEEPSEEK_API_KEY=your_deepseek_key_here

# Database Configuration
DATABASE_URL=bot_database.db
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# AmoCRM Integration
AMOCRM_SUBDOMAIN=your_subdomain
AMOCRM_CLIENT_ID=your_client_id
AMOCRM_CLIENT_SECRET=your_client_secret
AMOCRM_REDIRECT_URL=https://your-redirect-url.com/amocrmOAuthCallback

# Airtable Integration
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_airtable_base_id

# Group IDs
CRM_GROUP_ID=your_crm_group_id
CRM_TOPIC_ID=your_crm_topic_id
GSHEET_ID=your_google_sheet_id
GSHEET_CREDS_FILE=data/service_account.json
AUTORUN_MASS_SYNC=false

# Owner ID (Telegram user ID)
OWNER_ID=your_telegram_user_id