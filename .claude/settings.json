{
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(python -m py_compile *)",
      "mcp__ccd_session__mark_chapter",
      "mcp__computer-use__screenshot"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./**/*.session)",
      "Edit(./**/*.session)",
      "Bash(python src/main.py*)",
      "Bash(git reset --hard*)"
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
