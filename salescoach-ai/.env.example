# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://salescoach:secret@localhost:5432/salescoach

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# ── S3 / MinIO ────────────────────────────────────────────
S3_BUCKET=salescoach-audio
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── LLM ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── ASR ───────────────────────────────────────────────────
WHISPER_MODEL=large-v3

# ── Telegram Bot ──────────────────────────────────────────
BOT_TOKEN=
BOT_API_TOKEN=       # service account JWT for bot → API calls

# ── CRM ───────────────────────────────────────────────────
AMOCRM_SUBDOMAIN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=

# ── App URLs ──────────────────────────────────────────────
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
PORT=4000
