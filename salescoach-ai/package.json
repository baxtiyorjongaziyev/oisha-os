{
  "name": "salescoach-ai",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "pnpm run prisma:generate && turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "type-check": "pnpm run prisma:generate && turbo run type-check",
    "prisma:generate": "pnpm --filter @salescoach/api exec prisma generate"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.8",
      "fast-uri": "^3.1.4",
      "ioredis": "^5.11.1",
      "js-yaml": "^4.2.0",
      "multer": "^2.2.0",
      "nodemailer": "^9.0.1",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0",
      "@hono/node-server": "^2.0.5"
    }
  }
}
