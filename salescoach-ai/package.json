{
  "name": "salescoach-ai",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "pnpm run prisma:generate && turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "type-check": "pnpm run prisma:generate && turbo run type-check",
    "prisma:generate": "pnpm --filter @salescoach/api exec prisma generate"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.8",
      "deepmerge-ts": "^8.0.0",
      "fast-uri": "^3.1.5",
      "file-type": "^21.3.1",
      "hono": "^4.12.34",
      "ioredis": "^5.11.1",
      "ip-address": "^10.3.1",
      "js-yaml": "^4.3.1",
      "multer": "^2.2.0",
      "music-metadata": "^11.12.3",
      "nanoid": "^3.3.18",
      "nodemailer": "^9.0.1",
      "postcss": "^8.5.26",
      "sharp": "^0.35.0",
      "socket.io-parser": "^4.2.7",
      "uuid": "^11.1.1",
      "@hono/node-server": "^2.0.5"
    }
  }
}
