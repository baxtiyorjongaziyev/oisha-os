{
  "name": "salescoach-ai",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "prettier": "^3.8.5",
    "turbo": "^2.10.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "^5.11.1",
      "multer": "^2.2.0",
      "postcss": "^8.5.10",
      "js-yaml": "^4.2.0"
    }
  }
}
