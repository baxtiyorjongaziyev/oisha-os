{
  "name": "01 · Lead Lifecycle (AmoCRM → Oisha → Telegram)",
  "nodes": [
    {
      "id": "wh-amocrm",
      "name": "AmoCRM Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "amocrm-lead",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "respond-ok",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [200, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"ok\"}"
      }
    },
    {
      "id": "extract-lead",
      "name": "Extract Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 0],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst leads = body.leads?.add || body.leads?.update || body.leads?.status_changed || [];\nconst contacts = body.contacts?.add || body.contacts?.update || [];\n\nreturn leads.map(lead => ({\n  json: {\n    lead_id: lead.id,\n    lead_name: lead.name,\n    lead_status_id: lead.status_id,\n    lead_pipeline_id: lead.pipeline_id,\n    lead_responsible_user_id: lead.responsible_user_id,\n    lead_price: lead.price,\n    event_type: body.leads?.add ? 'add' : body.leads?.update ? 'update' : 'status_changed',\n    contact_name: contacts[0]?.name || null,\n    contact_phone: contacts[0]?.custom_fields_values?.find(f => f.field_code === 'PHONE')?.values?.[0]?.value || null,\n    timestamp: new Date().toISOString()\n  }\n}));"
      }
    },
    {
      "id": "oisha-ai",
      "name": "Oisha AI — Process Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OISHA_API_URL }}/api/lead/process",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Oisha-Key", "value": "={{ $env.OISHA_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "lead_id", "value": "={{ $json.lead_id }}" },
            { "name": "lead_name", "value": "={{ $json.lead_name }}" },
            { "name": "status_id", "value": "={{ $json.lead_status_id }}" },
            { "name": "pipeline_id", "value": "={{ $json.lead_pipeline_id }}" },
            { "name": "responsible_user_id", "value": "={{ $json.lead_responsible_user_id }}" },
            { "name": "price", "value": "={{ $json.lead_price }}" },
            { "name": "event_type", "value": "={{ $json.event_type }}" },
            { "name": "contact_name", "value": "={{ $json.contact_name }}" },
            { "name": "contact_phone", "value": "={{ $json.contact_phone }}" }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "check-action",
      "name": "Action Needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [800, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "leftValue": "={{ $json.action }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            }
          ]
        }
      }
    },
    {
      "id": "telegram-notify",
      "name": "Telegram — Notify Oisha",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, -100],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{ $env.OWNER_TELEGRAM_ID }}" },
            { "name": "text", "value": "={{ $json.telegram_message }}" },
            { "name": "parse_mode", "value": "HTML" }
          ]
        }
      }
    },
    {
      "id": "no-action",
      "name": "No Action (skip)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1000, 100],
      "parameters": {}
    }
  ],
  "connections": {
    "AmoCRM Webhook": {
      "main": [
        [
          { "node": "Respond 200", "type": "main", "index": 0 },
          { "node": "Extract Lead Data", "type": "main", "index": 0 }
        ]
      ]
    },
    "Extract Lead Data": {
      "main": [[{ "node": "Oisha AI — Process Lead", "type": "main", "index": 0 }]]
    },
    "Oisha AI — Process Lead": {
      "main": [[{ "node": "Action Needed?", "type": "main", "index": 0 }]]
    },
    "Action Needed?": {
      "main": [
        [{ "node": "Telegram — Notify Oisha", "type": "main", "index": 0 }],
        [{ "node": "No Action (skip)", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{"name": "oisha"}, {"name": "amocrm"}]
}
