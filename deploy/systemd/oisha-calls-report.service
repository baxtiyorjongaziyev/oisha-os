[Unit]
Description=Oisha daily Moizvonki sales calls report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/oisha-os
EnvironmentFile=/home/deploy/oisha-os/.env
ExecStart=/home/deploy/oisha-os/venv/bin/python scripts/daily_sales_calls_report.py
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
