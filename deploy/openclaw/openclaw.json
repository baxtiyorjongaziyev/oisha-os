{
  "$schema": "https://openclaw.ai/config.schema.json",
  "gateway": {
    "port": 18789,
    "mode": "local"
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace/oisha",
      "model": {
        "primary": "google/gemini-3.5-flash",
        "fallbacks": [
          "google/gemini-3.5-flash-lite",
          "google/gemini-3-flash-preview"
        ]
      }
    }
  },
  "skills": {
    "load": {
      "extraDirs": [
        "~/.openclaw/workspace/oisha/skills"
      ]
    },
    "allowBundled": [
      "weather",
      "github"
    ]
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "token": {
        "source": "env",
        "id": "TELEGRAM_BOT_TOKEN"
      }
    },
    "whatsapp": {
      "enabled": false
    },
    "slack": {
      "enabled": false
    },
    "discord": {
      "enabled": false
    }
  },
  "hooks": {
    "enabled": true,
    "path": "/hooks/oisha",
    "token": {
      "source": "env",
      "id": "OPENCLAW_SECRET"
    },
    "defaultSessionKey": "oisha-main"
  }
}
