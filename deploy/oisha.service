[Unit]
Description=Oisha-OS Enterprise AI Bot
After=network.target

[Service]
User=baxti
WorkingDirectory=/home/baxti/oisha-os
ExecStart=/home/baxti/oisha-os/venv/bin/python src/main.py
Restart=always
RestartSec=10
EnvironmentFile=/home/baxti/oisha-os/.env
StandardOutput=append:/home/baxti/oisha-os/data/oisha.log
StandardError=append:/home/baxti/oisha-os/data/oisha_err.log

[Install]
WantedBy=multi-user.target
