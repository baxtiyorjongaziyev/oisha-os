# Copy this file to .env on the Oracle server and fill the values there.
# Do not commit the real .env file to GitHub.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=n8n

# Generate on the server with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# First MVP: use your Oracle public IP, later replace with domain like automation.jonbranding.uz
N8N_HOST=YOUR_SERVER_IP_OR_DOMAIN
N8N_PROTOCOL=http
WEBHOOK_URL=http://YOUR_SERVER_IP_OR_DOMAIN:5678/
